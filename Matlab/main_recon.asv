%%

figure('DefaultAxesFontSize', 18);
imagesc(MyImage.x*1e3 + mean(X_m)*1000, MyImage.z*1e3, real(OriginIm));
axis image
xlim([-10 10]);
ylim([10 30]);
xlabel('x (mm)');
ylabel('z (mm)');
title('Reconstructed Object');




