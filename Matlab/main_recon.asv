cd C:\Users\duclos\Desktop\LIB\AcoustoOpticTomography\Matlab
addpath("SharedFunctions")
clear;
clc;
close;


FILE = load("dataLund1.mat");
% FILE = load("AOsignal_SIM_v2.mat");
dataAO = double(FILE.data);
decimations = double(FILE.decimations)';
thetas = ((double(FILE.thetas))*pi/180)'; % in rad
ActiveLIST = logical(FILE.ActiveList'); % binary
DelayLAWS = (FILE.DelayLaw')/1000;

N = 192;
delta_x = 0.2/1000; % in m
dFx = 1/(N*delta_x); % in m^-1
ScanParam = [thetas, decimations]; % Prepare scan parameters for OS function
SampleRate = 10; % in MHz
c = 1540; % in m/s
X0 = -N*delta_x/2*1000; % in mm
X1 = N*delta_x/2*1000; % in mm
X_m = linspace(X0, X1, N)*1e-3;  % in mm 
t_acq = (0:size(dataAO,1)-1)/(SampleRate*1e6);
z =(c * t_acq)'; % in m
Lc = 2*delta_x; % in m Lc = 1/Fc


MyImage = OS(dataAO,thetas,decimations,dFx,z,SampleRate*1e6,c,[X0 X1]*1e-3) ;
%%
Ireconstruct = MyImage.iRadon(X_m , DelayLAWS , ActiveLIST , dFx, Lc );
 %%
 figure('DefaultAxesFontSize',18);
 imagesc(MyImage.x*1e3 + mean(X_m)*1000,MyImage.z*1e3,real(Ireconstruct));
 axis image
xlim([-10 10]);
ylim([10 30]);
 xlabel('x(mm)')
 ylabel('z(mm)')



% Optionnel : pour une échelle uniforme
% axis xy;

 title('reconstructed object')
 colorbar

%% ================================== iFourier ==================================
        
% FTFx : matrix with fourier composant : first cols = first decimation,
% vaying angle , second lines : second decimate, varying angle...

% FTFxz = MyImage.fourierz(FTFx);
% MyImage.ScatterFourier(FTFxz,decimation , theta);
[~ , ~ ,~ , M0 ] = EvalDelayLawOS_shared( X_m  , DelayLAWS  , ActiveLIST , c ) ;


[ F_ct_kx , theta , decimation ] = MyImage.AddSinCos( MyImage.R ) ;




FTF = MyImage.InverseFourierX( F_ct_kx  , decimation , theta , M0 ) ;

OriginIm = sum(FTF,3) ;
 
